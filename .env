APP_NAME=crypto_follower
API_PREFIX=/api/v1

# 本地快速測試可維持 sqlite
DATABASE_URL=sqlite:///./crypto_follower.db

# 若要切換 MySQL，請改用例如：
# DATABASE_URL=mysql+pymysql://root:password@localhost:3306/crypto_follower

CREATE_TABLES_ON_STARTUP=true

ETHERSCAN_BASE_URL=https://api.etherscan.io/v2/api
ETHERSCAN_CHAIN_ID=1
ETHERSCAN_API_KEY=EXEQDBWKYIDIK113T25AX4XZKT9R2Z1AZZ
ETHERSCAN_MAX_PAGES=5
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3
COINGECKO_PLATFORM=ethereum
HTTP_TIMEOUT_SECONDS=30
DEFAULT_LOOKBACK_DAYS=90
