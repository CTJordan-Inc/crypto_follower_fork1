PRICE_PROVIDER=coingecko
COINCAP_BASE_URL=https://api.coincap.io/v2
COINCAP_API_KEY=0a2d432834b0261fa733aabfd80606aef1802b1e999da70a5e6b9427a58fe1d2
COINCAP_API_KEY_HEADER=Authorization
COINCAP_MAX_RETRIES=3
COINCAP_BACKOFF_SECONDS=1.0
COINCAP_REQUEST_INTERVAL_SECONDS=0.3
HTTP_TIMEOUT_SECONDS=30
DEFAULT_LOOKBACK_DAYS=90
SYNC_CACHE_TTL_MINUTES=720
BATCH_ADDRESS_LIMIT=50
SAVED_ANALYSIS_LIMIT=100
RANDOM_ADDRESS_BLOCK_WINDOW=160
RANDOM_ADDRESS_SAMPLE_BLOCKS=12
RANDOM_ADDRESS_CANDIDATE_MULTIPLIER=2
RANDOM_ADDRESS_SCREEN_TIME_BUDGET_SECONDS=90
